   "locked": false,
   "text": "message Post {\n  int64 id = 1;\n  int64 author_id = 2;\n  string author_name = 3;\n  string title = 4;\n  string body = 5;\n  repeated string tags = 6;\n  int64 like_count = 7;\n  int64 comment_count = 8;\n  int32 version = 9;\n  google.protobuf.Timestamp created_at = 10;\n}\n\nmessage Comment {\n  int64 id = 1;\n  int64 post_id = 2;\n  int64 parent_id = 3;\n  int64 author_id = 4;\n  string author_name = 5;\n  string body = 6;\n  google.protobuf.Timestamp created_at = 7;\n}\n\nmessage CreatePostRequest {\n  string title = 1;\n  string body = 2;\n  repeated string tags = 3;\n  string idempotency_key = 4;\n}\n\nmessage UpdatePostRequest {\n  int64 id = 1;\n  string title = 2;\n  string body = 3;\n  int32 version = 4;\n}\n\nmessage ListPostsRequest {\n  oneof filter { int64 author_id = 1; string tag = 2; }\n  string cursor = 3;\n  int32 limit = 4;\n}\n\nmessage ListPostsResponse {\n  repeated Post posts = 1;\n  string next_cursor = 2;\n}\n\nmessage CreateCommentRequest {\n  int64 post_id = 1;\n  int64 parent_id = 2;\n  string body = 3;\n  string idempotency_key = 4;\n}\n\nmessage ListCommentsRequest {\n  int64 post_id = 1;\n  string cursor = 2;\n  int32 limit = 3;\n}\n\nmessage ListCommentsResponse {\n  repeated Comment comments = 1;\n  string next_cursor = 2;\n}",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "message Post {\n  int64 id = 1;\n  int64 author_id = 2;\n  string author_name = 3;\n  string title = 4;\n  string body = 5;\n  repeated string tags = 6;\n  int64 like_count = 7;\n  int64 comment_count = 8;\n  int32 version = 9;\n  google.protobuf.Timestamp created_at = 10;\n}\n\nmessage Comment {\n  int64 id = 1;\n  int64 post_id = 2;\n  int64 parent_id = 3;\n  int64 author_id = 4;\n  string author_name = 5;\n  string body = 6;\n  google.protobuf.Timestamp created_at = 7;\n}\n\nmessage CreatePostRequest {\n  string title = 1;\n  string body = 2;\n  repeated string tags = 3;\n  string idempotency_key = 4;\n}\n\nmessage UpdatePostRequest {\n  int64 id = 1;\n  string title = 2;\n  string body = 3;\n  int32 version = 4;\n}\n\nmessage ListPostsRequest {\n  oneof filter { int64 author_id = 1; string tag = 2; }\n  string cursor = 3;\n  int32 limit = 4;\n}\n\nmessage ListPostsResponse {\n  repeated Post posts = 1;\n  string next_cursor = 2;\n}\n\nmessage CreateCommentRequest {\n  int64 post_id = 1;\n  int64 parent_id = 2;\n  string body = 3;\n  string idempotency_key = 4;\n}\n\nmessage ListCommentsRequest {\n  int64 post_id = 1;\n  string cursor = 2;\n  int32 limit = 3;\n}\n\nmessage ListCommentsResponse {\n  repeated Comment comments = 1;\n  string next_cursor = 2;\n}",
   "autoResize": true,
   "lineHeight": 1.25
  },
