# HTTP/3 tool (quic-go) + version prover, plus iproute2 for netem.
# arm64-native, unlike the curl-http3 images which have no Apple-silicon build.
FROM golang:1.26-alpine AS build
RUN apk add --no-cache git
WORKDIR /src
COPY h3client/go.mod ./
COPY h3client/*.go ./
RUN go mod tidy && CGO_ENABLED=0 go build -o /h3client .

FROM alpine:3.20
RUN apk add --no-cache iproute2 iputils bash python3 curl ca-certificates
COPY --from=build /h3client /usr/local/bin/h3client
